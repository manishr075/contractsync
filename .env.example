# ContractSync Environment Configuration

# Switch Server Connection
SWITCH_SERVER_URL=http://127.0.0.1:8787
SWITCH_PORT=8787
SWITCH_HOST=127.0.0.1

# Optional: Remote Switch Deployment Credentials
# If connecting to an external or corporate self-hosted Switch server:
# SWITCH_API_KEY=sw_your_agent_api_key_here
# SWITCH_ROOM_ID=api-contract-room

# Node Environment
NODE_ENV=development
